{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hybrid-arena.com/integrations/games/managed-v1/package.schema.json",
  "title": "Reviewed Arena managed game package",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "arena.managed-game.v1"
    },
    "blueprint": {
      "enum": [
        "signal-rush",
        "drone-dash",
        "robot-duel",
        "core-control"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 20,
      "maximum": 90
    },
    "bot_difficulty": {
      "enum": [
        "easy",
        "normal",
        "hard"
      ]
    },
    "palette": {
      "enum": [
        "teal",
        "orange",
        "pink"
      ]
    }
  },
  "required": [
    "schema",
    "blueprint",
    "version",
    "duration_seconds",
    "bot_difficulty",
    "palette"
  ]
}
