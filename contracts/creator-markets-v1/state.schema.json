{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Creator timed-score source market state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rule_family",
    "publisher_id",
    "game_id",
    "manifest_sha256",
    "package_sha256",
    "match_id",
    "epoch",
    "accepted_sequence",
    "source_tick",
    "game_time_ms",
    "observed_at",
    "status",
    "duration_ms",
    "outcomes",
    "winner",
    "state_hash"
  ],
  "properties": {
    "schema": {
      "const": "arena.creator-market-state.v1"
    },
    "rule_family": {
      "const": "timed_score_v1"
    },
    "publisher_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "game_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "match_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "epoch": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "accepted_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "game_time_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "observed_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "waiting",
        "live",
        "completed",
        "canceled",
        "held"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "outcomes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome_id",
          "score"
        ],
        "properties": {
          "outcome_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        }
      }
    },
    "winner": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
