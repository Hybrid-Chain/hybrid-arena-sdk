        "parameters": [
          {
            "name": "X-Arena-Key-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Arena-Publisher",
            "in": "header",
            "required": true,
