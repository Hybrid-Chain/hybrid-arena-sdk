{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2024", "DOM", "DOM.Iterable"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "declaration": true, "sourceMap": true,
    "rootDir": "src", "outDir": "dist", "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
