{
  "name": "@hybrid-chain/arena-sdk",
  "version": "0.1.0-alpha.1",
  "description": "Hybrid Arena game-provider SDK and local reference sandbox",
  "type": "module",
  "license": "MIT",
  "engines": {"node": ">=22.13.0"},
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"}},
  "bin": {"arena": "./scripts/arena.mjs"},
  "files": ["dist", "contracts", "scripts/arena.mjs", "reference", "examples", "docs", "README.md", "LICENSE"],
  "scripts": {
    "test:contracts": "node --test tests/contracts.test.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:python": "PYTHONPATH=python/src python3 -m unittest discover -s python/tests",
    "sandbox": "node scripts/arena.mjs sandbox --demo",
    "prepack": "npm run build"
  },
  "dependencies": {"ajv": "8.20.0"},
  "devDependencies": {"@types/node": "22.19.19", "typescript": "5.9.3"},
  "repository": {"type": "git", "url": "https://github.com/Hybrid-Chain/hybrid-arena-sdk.git"}
}
